# Supabase project settings — find these in the Supabase dashboard
# under Settings -> API for the "ai-women-platform" project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service-role key — bypasses RLS. ONLY used by offline ingestion scripts
# (backend/app/ingestion/), never by the running API server's request
# handlers. Optional: the server boots without it; only required to
# actually run an ingestion script. Find it in the Supabase dashboard
# under Settings -> API (the "service_role" secret, not "anon").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of allowed frontend origins for CORS (local dev).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider configuration — all optional. ONLY used by offline AI
# scripts (backend/app/ingestion/run_enrich_content.py), never by the
# running API server's request handlers. The server boots fine without
# these.
#
# AI_PROVIDER selects which provider app/ai/factory.get_ai_provider()
# returns:
#   fake   (default) - DevAIProvider: deterministic mock data, no API
#                       key needed, no external call. Use this for local
#                       development, including when you have no
#                       Anthropic API key or your account has no credits.
#   claude            - the real Anthropic provider. Requires
#                       ANTHROPIC_API_KEY below.
AI_PROVIDER=fake

# Only required when AI_PROVIDER=claude. Find your API key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
