# Supabase project settings — find these in the Supabase dashboard
# under Settings -> API for the "ai-women-platform" project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service-role key — bypasses RLS. ONLY used by offline ingestion scripts
# (backend/app/ingestion/), never by the running API server's request
# handlers. Optional: the server boots without it; only required to
# actually run an ingestion script. Find it in the Supabase dashboard
# under Settings -> API (the "service_role" secret, not "anon").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of allowed frontend origins for CORS (local dev).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
